# Virtual environment
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Cloned upstream reference repository
dextra-roshambo-python/

# Raw recordings and generated frames (large; back them up separately)
data/

# Downloadable model assets
models/*.task
# Dextra weights and samples: the upstream repo has no license, so do not redistribute
models/dextra/
# Trained and tuned model files: tuned ones are built from Dextra's weights (same reason), and
# all of them are rebuilt from data/ with train.py
models/*.pth
models/*_metrics.png

# Per-run logs
*.log
logs/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
